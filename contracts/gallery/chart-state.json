  "nativeStateNotes": {
    "partition": "default is getStateKey(widget) for gallery widgets without period, transpose, selectedGroup, reversed, currentSheet, selectedRatio or pivot mode; never substitute widget instance IDs.",
    "sankey": "Use state.storage.default.chartModel and state.storage.default.sankey.sankeySetup. Omit top-level state.chartModel: createCustomTemplateTab would replace the saved sankey object with {cellRange}, deleting setup.",
    "aggregation": "Omitted for raw daily return observations and ordinary charts. Hierarchy sum derives parents from mutually exclusive leaves. Never aggregate repeated daily returns before box/range/histogram projection.",
    "histogram": "Explicit 12 bins, binCount omitted. Caller chooses first matching [lower,upper); final interval accepts every remaining finite value <= final upper (including below-first-edge values). Non-final internal edges join the following bin. Missing values skipped. Retained AAPL observations must all lie in these bounds; fail generation otherwise.",
    "waterfall": "Five signed movements only; final cumulative balance equals reported net income. Current caller has no saved total/subtotal bar support. Do not append reported income subtotals as movements or invent total-step fields.",
    "monthlyReturns": "Wide company-by-month matrix preserves native Heatmap numeric-column X labels; Grouped Column/Bar select only return202501. Company values use companies mapping, while raw symbol remains available for provenance and the native AAPL filter.",
    "filters": "Histogram and Range Area use the native state.filterModel.default symbol text-equals AAPL filter; no prefiltered extra endpoint.",
    "combos": "Preset combo models omit seriesChartTypes; nonempty assignments select custom semantics. Custom EPS is right axis, other selected measures left.",
    "verificationBoundary": "Fixture freezes payload shapes and column semantics. HG0 unit hydration does not prove all chart renderers, data projections, Apps navigation, persistence or redeployment; those require HG1-HG3 acceptance."
  }
}
