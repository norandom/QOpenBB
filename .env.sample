# Public template; copy to .env only if it does not already exist.
# Keys stay in ignored .env. Never upload it to build contexts or image layers.
# Specification-stage: images, routing and authentication are not implemented.
PUBLIC_URL=https://qbb.hanse-hedge.fund

# Primary providers; injected only into data-api.
FMP_API_KEY=
FRED_API_KEY=

# Default Workspace AI provider; injected only into the self-hosted agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Immutable image references from the future Dagger release. Full Workspace.
WORKSPACE_IMAGE=
DATA_API_IMAGE=
AGENT_IMAGE=
EXCEL_IMAGE=

# Optional future providers; not currently wired.
ECONDB_API_KEY=
OPENAI_API_KEY=

# Plain HTTP origin 0.0.0.0:23003; user owns Cloudflare Access/cloudflared.
# Bind-mounted state ./data/workspace. No Docker-managed volumes or Jupyter.
# Registry credentials live in GitHub secrets / docker login, not app services.
