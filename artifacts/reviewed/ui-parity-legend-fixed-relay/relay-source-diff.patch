+            if any(pair["buffers"]):
+                self.breach("socket-error")
+            self.close_pair(pair)
+        except OSError:
+            self.breach("socket-error")
+            self.close_pair(pair)
+
+    def tick(self):
+        for pair in self.pairs[:]:
+            if pair["connecting"] and self.clock() >= pair["connectBy"]:
