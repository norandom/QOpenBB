# Public template. Copy to .env; never commit real credentials.
# Current repository is specification-stage, not a runnable deployment.
# Keep values empty until configured. Do not pass this whole file as build args.

# Primary external data providers: FMP and FRED. Both required for the baseline.
FMP_API_KEY=
FRED_API_KEY=
# Latest OpenBB requires an EconDB provider adaptation before this is usable.
ECONDB_API_KEY=

# Immutable release image references from the future Dagger/GitHub release.
# WORKSPACE_IMAGE must be built with OPENBB_IMAGE_VARIANT=full.
WORKSPACE_IMAGE=
DATA_API_IMAGE=
EXCEL_IMAGE=
JUPYTER_IMAGE=

# Local loopback ports in the Compose proposal.
WORKSPACE_PORT=3000
DATA_API_PORT=6900
EXCEL_PORT=3001
JUPYTER_PORT=8888

# Optional notebook profile: choose a strong token before enabling.
JUPYTER_TOKEN=

# Optional future AI integration. These conventional provider keys are not
# wired to an AI backend yet. Configure only the provider eventually selected.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Registry credentials belong in GitHub Actions secrets / docker login,
# not in runtime containers. Workspace bootstrap and API authentication
# settings will be added after their integration contract is verified.
