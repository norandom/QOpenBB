{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-asset and macro input verification record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_sha256",
    "notice",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "matrix_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "provider",
          "route",
          "identity",
          "history",
          "display_status",
          "usable_in_stories",
          "verification",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "enum": [
              "fmp",
              "fred"
            ]
          },
          "route": {
            "enum": [
              "/api/v1/equity/price/historical",
              "/api/v1/economy/fred_series"
            ]
          },
          "identity": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "price_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adjustment",
              "excludes_dividends"
            ],
            "properties": {
              "adjustment": {
                "const": "splits_only"
              },
              "excludes_dividends": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "history": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "earliest": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "latest": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "rows": {
                "type": "integer",
                "minimum": 0
              },
              "early_window_rows": {
                "type": "integer",
                "minimum": 0
              },
              "early_window_earliest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "truncated": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "weekday_gaps": {
                "type": "integer",
                "minimum": 0
              },
              "duplicate_dates": {
                "type": "integer",
                "minimum": 0
              },
              "order_faults": {
                "type": "integer",
                "minimum": 0
              },
              "missing_observations": {
                "type": "integer",
                "minimum": 0
              },
              "gap_ranges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end",
                    "weekdays"
                  ],
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "end": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "weekdays": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "early_window_latest": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "early_window_weekday_gaps": {
                "type": "integer",
                "minimum": 0
              },
              "early_window_gap_ranges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end",
                    "weekdays"
                  ],
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "end": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                    },
                    "weekdays": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              },
              "coverage_note": {
                "type": "string",
                "minLength": 1
              },
              "early_window_duplicate_dates": {
                "type": "integer",
                "minimum": 0
              },
              "early_window_order_faults": {
                "type": "integer",
                "minimum": 0
              },
              "early_window_retrieved_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "retrieved_at",
              "effective_query"
            ],
            "properties": {
              "retrieved_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              "effective_query": {
                "type": "object",
                "minProperties": 1
              }
            }
          },
          "display_status": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "basis"
            ],
            "properties": {
              "status": {
                "enum": [
                  "government-source",
                  "public-source",
                  "provider-licensed",
                  "third-party-copyrighted",
                  "unknown"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "source_institution": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "pattern": "^https://"
              },
              "checked_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "rights_label": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "usable_in_stories": {
            "type": "boolean"
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "blocked-entitlement",
                  "failed",
                  "unverified"
                ]
              },
              "checked_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "image_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "evidence_sha256": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "if": {
              "properties": {
                "status": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "required": [
                "status",
                "checked_on",
                "image_digest",
                "evidence_sha256"
              ]
            }
          },
          "limits": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
