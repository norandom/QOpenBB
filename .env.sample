# Public template; copy to .env only if it does not already exist.
# Keys stay in ignored .env. Never upload it to build contexts or image layers.
# Development alpha inputs. Stable versions will use pinned image references.
PUBLIC_URL=http://127.0.0.1:23003
WORKSPACE_BIND_IP=0.0.0.0
WORKSPACE_HOST_PORT=23003

# Optional bootstrap administrator. Blank reuses persisted/generated credentials.
# Nonempty values create/update this administrator on container startup.
# Choose a strong, unique password. Single-quote values containing $.
# After editing .env, recreate Workspace; restart does not reload these values.
OPENBB_ADMIN_EMAIL=
OPENBB_ADMIN_PASSWORD=

# Workspace signs short-lived assertions for the private modeling listener.
# Provision a dedicated random secret and key ID when enabling that listener.
QFM_IDENTITY_CURRENT_KID=
QFM_IDENTITY_CURRENT_SECRET=
# Uncomment both previous key variables only while rotating the listener key.
# QFM_IDENTITY_PREVIOUS_KID=
# QFM_IDENTITY_PREVIOUS_SECRET=

# Primary providers; injected only into data-api.
FMP_API_KEY=
FRED_API_KEY=

# Future separate AI spec; not required by the two-service prototype.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Moving prebuilt alpha images for development.
WORKSPACE_IMAGE=ghcr.io/norandom/qopenbb-workspace:latest
DATA_API_IMAGE=ghcr.io/norandom/qopenbb-data-api:latest
# Set a registry/repository@sha256 reference for the opt-in modeling deployment.
MODELING_IMAGE=
AGENT_IMAGE=
EXCEL_IMAGE=

# Optional future providers; not currently wired.
ECONDB_API_KEY=
OPENAI_API_KEY=

# Plain HTTP origin 0.0.0.0:23003; user owns Cloudflare Access/cloudflared.
# State is under ./data/workspace and, when enabled, ./data/modeling (10001:10001, 0700).
# Registry credentials live in GitHub secrets / docker login, not app services.
