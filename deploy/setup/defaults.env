# Apply private installer defaults when the user leaves a value empty.
FMP_API_KEY=${FMP_API_KEY:-${QOPENBB_SETUP_FMP_API_KEY:-}}
FRED_API_KEY=${FRED_API_KEY:-${QOPENBB_SETUP_FRED_API_KEY:-}}
QFM_IDENTITY_CURRENT_KID=${QFM_IDENTITY_CURRENT_KID:-${QOPENBB_SETUP_QFM_IDENTITY_CURRENT_KID:-}}
QFM_IDENTITY_CURRENT_SECRET=${QFM_IDENTITY_CURRENT_SECRET:-${QOPENBB_SETUP_QFM_IDENTITY_CURRENT_SECRET:-}}
WORKSPACE_BIND_IP=${WORKSPACE_BIND_IP:-127.0.0.1}
QOPENBB_SETUP_MODELING_IMAGE=${QOPENBB_CHECKOUT_MODELING_IMAGE:-${QOPENBB_SETUP_MODELING_IMAGE:-}}
